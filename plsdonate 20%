-- Number formatting with commas (e.g., 10,000)
local function formatCommas(num)
	local formatted = tostring(math.floor(num))
	while true do
		local k
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
		if k == 0 then break end
	end
	return formatted
end

-- Strip commas/symbols from text to get raw number
local function parseRawNumber(str)
	if not str then return nil end
	local cleaned = string.gsub(str, "[^%d]", "")
	return tonumber(cleaned)
end

-- 6. Rolling Counter Animation for any detected HUD TextLabel
local function animateHUDLabel(label, startVal, addVal)
	local targetVal = startVal + addVal
	local duration = 1.5
	local elapsed = 0
	local connection

	connection = RunService.RenderStepped:Connect(function(dt)
		elapsed = elapsed + dt
		local alpha = math.clamp(elapsed / duration, 0, 1)
		-- EaseOutQuad curve
		local progress = 1 - (1 - alpha) * (1 - alpha)
		local currentVal = math.floor(startVal + (targetVal - startVal) * progress)
		label.Text = formatCommas(currentVal)

		if alpha >= 1 then
			connection:Disconnect()
			label.Text = formatCommas(targetVal)
		end
	end)
end

-- Search PlayerGui for matching Giftbux balance label
local function updateHUDCounter(addAmount)
	local searchStr = currentBalBox.Text
	local targetBalance = parseRawNumber(searchStr)
	if not targetBalance then return end

	for _, guiObj in ipairs(playerGui:GetDescendants()) do
		if guiObj:IsA("TextLabel") and not guiObj:IsDescendantOf(screenGui) then
			local numInLabel = parseRawNumber(guiObj.Text)
			if numInLabel and numInLabel == targetBalance then
				animateHUDLabel(guiObj, targetBalance, addAmount)
				currentBalBox.Text = tostring(targetBalance + addAmount)
				break
			end
		end
	end
end

-- 7. Animated PLS DONATE Popup Banner
local function spawnDonationBanner(donorName, amount)
	local banner = Instance.new("Frame")
	banner.Size = UDim2.new(0, 420, 0, 68)
	banner.Position = UDim2.new(0.5, -210, 1, 80) -- Starts below bottom of screen
	banner.BackgroundColor3 = Color3.fromRGB(22, 28, 24)
	banner.BorderSizePixel = 0
	banner.Parent = screenGui

	local bCorner = Instance.new("UICorner")
	bCorner.CornerRadius = UDim.new(0, 14)
	bCorner.Parent = banner

	local bStroke = Instance.new("UIStroke")
	bStroke.Color = Color3.fromRGB(40, 235, 115)
	bStroke.Thickness = 3
	bStroke.Parent = banner

	local msgLabel = Instance.new("TextLabel")
	msgLabel.Size = UDim2.new(1, -24, 1, 0)
	msgLabel.Position = UDim2.new(0, 12, 0, 0)
	msgLabel.BackgroundTransparency = 1
	msgLabel.RichText = true
	msgLabel.Text = string.format(
		'<font color="#FFFFFF">@%s</font> donated <font color="#28EB73"> %s</font> to <font color="#FFFFFF">@%s</font>!',
		donorName,
		formatCommas(amount),
		player.Name
	)
	msgLabel.Font = Enum.Font.FredokaOne
	msgLabel.TextSize = 20
	msgLabel.TextWrapped = true
	msgLabel.Parent = banner

	-- Pop up from bottom
	TweenService:Create(banner, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, -210, 0.82, 0)
	}):Play()

	-- Hold, then slide back down
	task.delay(3.5, function()
		local hideTween = TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, -210, 1, 80)
		})
		hideTween:Play()
		hideTween.Completed:Connect(function()
			banner:Destroy()
		end)
	end)
end

